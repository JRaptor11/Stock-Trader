# Application
ENV=development
SERVICE_MODE=paper_trading
BROKER_EXECUTION_ENABLED=true
PORT=8000
SYMBOL=AAPL,MSFT,NVDA,AMZN,META

# Alpaca paper trading
API_KEY=replace_with_alpaca_paper_key
SECRET_KEY=replace_with_alpaca_paper_secret
ALPACA_URL=https://paper-api.alpaca.markets

# Required route credentials
HEALTH_USERNAME=replace_with_username
HEALTH_PASSWORD=replace_with_strong_password

# Optional email alerts
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safe execution defaults
OLD_STREAM_STRATEGY_ENABLED=false
LAYER4_EXECUTION_ENABLED=false
LAYER3_MARKET_HOURS_ONLY=true
FAIL_SAFE_EXTENDED_HOURS_ENABLED=true
FAIL_SAFE_POSITION_CONFIRMATIONS=2
FAIL_SAFE_EXTENDED_HOURS_MAX_QUOTE_AGE_SECONDS=15
FAIL_SAFE_EXTENDED_HOURS_MAX_SPREAD_PCT=1.5
FAIL_SAFE_EXTENDED_HOURS_LIMIT_OFFSET_BPS=5
FAIL_SAFE_EXTENDED_HOURS_REPRICE_SECONDS=20
# Optional manual/externally-maintained map, for example:
# EARNINGS_DATES_JSON={"AMD":"2026-08-04","NVDA":"2026-08-26"}
EARNINGS_DATES_JSON={}
ENABLE_DEV_ROUTES=false

# Startup and recovery behavior
LAYER3_BOOTSTRAP_CONFIRMATION_ENABLED=true
LAYER3_BOOTSTRAP_MIN_BAR_COUNT=8
LAYER3_OPENING_TRANSITION_CYCLES=6
LAYER3_RESTART_RECOVERY_ENABLED=true
LAYER3_RESTART_RECOVERY_BARS=2
LIVE_STRATEGY_SHADOW_REST_BOOTSTRAP_ENABLED=true
# Preserve full-cohort parity when possible; permit a clearly labeled partial
# diagnostic when at least this many symbols share a completed live bar.
LIVE_STRATEGY_SHADOW_MIN_COHORT_SYMBOLS=9
RESEARCH_STRATEGY_SHADOW_ENABLED=true
FAIL_SAFE_REENTRY_COOLDOWN_SECONDS=3600

# Data-quality gates
LAYER_MONITOR_RUN_24_7=true
BAR_FRESHNESS_MARKET_HOURS_ONLY=true
BAR_FRESHNESS_MAX_AGE_MINUTES=35
BAR_FRESHNESS_MIN_FRESH_SYMBOLS=5
BAR_FRESHNESS_MIN_FRESH_RATIO=0.70

# Rolling execution limits
LAYER3_ROLLING_TRADE_LIMITS_ENABLED=true
LAYER3_ROLLING_LIMIT_WINDOW_SECONDS=600
LAYER3_MAX_TRADES_PER_ROLLING_WINDOW=6
LAYER3_MAX_BUYS_PER_ROLLING_WINDOW=3
LAYER3_MAX_SELLS_PER_ROLLING_WINDOW=3
LAYER3_MAX_BUY_NOTIONAL_PER_ROLLING_WINDOW=22500
LAYER3_MAX_SELL_NOTIONAL_PER_ROLLING_WINDOW=22500
LAYER3_MAX_GROSS_NOTIONAL_PER_ROLLING_WINDOW=45000

# Target stabilization
LAYER3_TARGET_HYSTERESIS_ENABLED=true
LAYER3_TARGET_MATERIAL_CHANGE=0.025
LAYER3_TARGET_CANDIDATE_TOLERANCE=0.010
LAYER3_TARGET_INCREASE_CONFIRMATION_BARS=2
LAYER3_TARGET_DECREASE_CONFIRMATION_BARS=1
LAYER3_TARGET_REMOVAL_CONFIRMATION_BARS=2

# Optional diagnostic output directory
LAYER_CSV_DIR=.

# Historical research worker (use in a separate environment/service)
# SERVICE_MODE=historical_research
# BROKER_EXECUTION_ENABLED=false
# RESEARCH_JOB_DIR=research_jobs/inbox
# RESEARCH_DATA_DIR=research_data
# RESEARCH_RESULTS_DIR=research_results
# RESEARCH_POLL_SECONDS=10
# RESEARCH_API_TOKEN=replace_with_at_least_24_random_characters
# RESEARCH_MAX_UPLOAD_BYTES=2147483648
# Optional durable S3-compatible artifact storage
# RESEARCH_S3_BUCKET=
# RESEARCH_S3_PREFIX=stock-trader-research
# RESEARCH_S3_ENDPOINT=
# RESEARCH_S3_REGION=us-east-1
# RESEARCH_S3_ACCESS_KEY=
# RESEARCH_S3_SECRET_KEY=
